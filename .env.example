# Copy to .env and fill in. .env is git-ignored: keys live only here.

# --- Alpaca: PAPER account keys (no live trading exists in this software) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex = free feed (pessimistic, biased against active strategies; at most 30 live tickers)
# sip = full consolidated feed (needs Alpaca's Algo Trader Plus plan). Never downgraded silently.
ALPACA_FEED=iex

# --- LLM: IBM Consulting Advantage (OpenAI-compatible) ---
ICA_API_KEY=
ICA_BASE_URL=https://api.remea.ica.ibm.com/ica/v1
ICA_NAMESPACE=chat-models
LLM_TRIAGE_MODEL=claude-haiku-5-5
LLM_DECISION_MODEL=claude-opus-5-5
# USD per million tokens [input, output]. Defaults are Anthropic list prices; set what ICA really charges you.
# LLM_PRICES={"claude-haiku-5-5":[0.10,0.50],"claude-opus-5-5":[4,20]}

# --- SEC EDGAR requires a contact address in the User-Agent header ---
SEC_USER_AGENT_EMAIL=

# --- Simulation ---
STARTING_CAPITAL_USD=5000
# Always-live tickers; the remaining data slots rotate between tickers the agents ask for.
# CORE_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AVGO,JPM,V,UNH,XOM,LLY,WMT,COST,AMD,NFLX,BAC
# STRATEGIES=buy_hold,random,momentum,mean_reversion,llm_light,tradingagents
# TRADINGAGENTS_TICKERS=NVDA,AAPL,MSFT
# INSTALL_TRADINGAGENTS=1        # build-time: adds the multi-agent strategy (large download)
# PAPER_CROSSCHECK=true          # mirror orders to the Alpaca paper account and show the deviation
LOG_LEVEL=INFO
