# Copy to .env and fill in. .env is git-ignored: keys live only here.

# --- Alpaca (paper account keys; no live trading is implemented) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex = free feed (pessimistic, biased against active strategies; max 30 streamed symbols)
# sip = full consolidated feed (needs Algo Trader Plus). The app never downgrades silently.
ALPACA_FEED=iex

# --- LLM: IBM Consulting Advantage (OpenAI-compatible) ---
ICA_API_KEY=
ICA_BASE_URL=https://api.remea.ica.ibm.com/ica/v1
ICA_NAMESPACE=chat-models

# --- SEC EDGAR requires a contact address in the User-Agent header ---
SEC_USER_AGENT_EMAIL=

# --- Simulation defaults ---
STARTING_CAPITAL_USD=5000
LOG_LEVEL=INFO
